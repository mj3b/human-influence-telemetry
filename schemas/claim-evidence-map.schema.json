{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mj3b/human-influence-telemetry/schemas/claim-evidence-map.schema.json",
  "title": "HIT claim-evidence map",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "map_id", "scope", "fitness_dimensions", "claims"],
  "properties": {
    "version": {"const": "0.6.5"},
    "map_id": {"const": "HIT-COE-V0.6.5"},
    "scope": {"type": "string", "minLength": 1},
    "fitness_dimensions": {
      "const": ["directness", "contemporaneity", "independence", "completeness", "publication_authority"]
    },
    "claims": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "state": {"enum": ["pass", "fail", "indeterminate", "outside_scope"]},
    "fitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directness", "contemporaneity", "independence", "completeness", "publication_authority"],
      "properties": {
        "directness": {"$ref": "#/$defs/fitness_dimension"},
        "contemporaneity": {"$ref": "#/$defs/fitness_dimension"},
        "independence": {"$ref": "#/$defs/fitness_dimension"},
        "completeness": {"$ref": "#/$defs/fitness_dimension"},
        "publication_authority": {"$ref": "#/$defs/fitness_dimension"}
      }
    },
    "fitness_dimension": {
      "type": "object", "additionalProperties": false, "required": ["state", "rationale"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "rationale": {"type": "string", "minLength": 1}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "path", "locator", "role", "integrity", "support_review"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
        "path": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "role": {"enum": ["contract", "implementation", "result", "method", "limitation", "metadata", "paper"]},
        "integrity": {"enum": ["git_tracked", "locked_digest", "pending", "remote_only"]},
        "support_review": {"enum": ["recorded", "pending", "outside_scope"]}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "claim_text", "claim_class", "status", "evidence", "fitness", "dependencies", "declared_gates", "conclusion_eligible", "limitations", "reversal_conditions"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^(H[1-9]|PAPER-C[0-9]{2})$"},
        "claim_text": {"type": "string", "minLength": 1},
        "claim_class": {"enum": ["structural", "methodological", "empirical", "hypothesis", "boundary", "adoption", "publication"]},
        "status": {"enum": ["supported", "provisional", "blocked", "unsupported", "pending"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "fitness": {"$ref": "#/$defs/fitness"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(H[1-9]|PAPER-C[0-9]{2})$"}},
        "declared_gates": {
          "type": "object", "additionalProperties": false,
          "required": ["traceability", "integrity", "human_support_review", "evidence_fitness", "dependency_closure"],
          "properties": {
            "traceability": {"$ref": "#/$defs/state"}, "integrity": {"$ref": "#/$defs/state"},
            "human_support_review": {"$ref": "#/$defs/state"}, "evidence_fitness": {"$ref": "#/$defs/state"},
            "dependency_closure": {"$ref": "#/$defs/state"}
          }
        },
        "conclusion_eligible": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reversal_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
